{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skill Helm",
  "version": "0.1.1",
  "identifier": "dev.skill-helm.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Skill Helm",
        "width": 1280,
        "height": 780,
        "minWidth": 1080,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ws://localhost:1420; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERGQTZFMDNBMUI0RTQyRkQKUldUOVFrNGJPdUNtMzhTVExQQ1JLeDJxQXJEVEVQSnhKVi9OK2toUVdiQ3VkTkhsYktZQUlTUkoK",
      "endpoints": [
        "https://github.com/coconilu/skill-helm/releases/latest/download/latest.json"
      ]
    }
  }
}
